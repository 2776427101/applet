# =============================================================
# 班级助手 · 环境变量示例
#
# 用法：cp .env.example .env，填好值，然后
#       set -a && source .env && set +a
#       （Windows PowerShell: Get-Content .env | ForEach-Object { ... }，或直接在
#         启动命令前写 $env:DB_PASSWORD="..."）
#
# .env 已在 .gitignore 里。**这个示例文件会被提交，所以这里不能出现任何真 key。**
# =============================================================

# ---------- 数据库 ----------
DB_USER=root
DB_PASSWORD=change-me

# ---------- 微信小程序 ----------
# 本地开发保持 WX_MOCK=true，登录会固定成种子数据里的李光老师（02_seed.sql）
WX_MOCK=true
# 正式环境必须设 false，并填真实的 AppID / AppSecret
WX_APPID=
WX_SECRET=

# ---------- JWT ----------
# 正式环境必须换成足够长的随机串，例如：
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-please-32-chars-min

# ---------- 乐迪（DeepSeek） ----------
# 不配也能启动，只有乐迪会提示未配置。key 只能在服务端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 群聊附件 ----------
# 相对路径是相对"启动时的工作目录"。线上请指到不会被清理、且随备份走的位置。
UPLOAD_DIR=./uploads

# ---------- 前端（构建时读取，不是后端变量） ----------
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_USE_MOCK_LOGIN=true
