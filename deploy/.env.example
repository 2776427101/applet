# 班级助手 · 生产环境变量
#
# 用法：cp .env.example .env  然后逐项填真实值。
# .env 已被 .gitignore 排除，**不要提交**。
#
# ⚠️ 三个密码都不要复用，也不要和本地开发环境一样。
#    这是公网可达的机器，被撞库是最常见的入侵方式。

# ---------------------------------------------------------------- 数据库
# MySQL root 密码。容器初始化时写入，之后存在数据卷里。
# 忘了只能删卷重来（数据全丢），所以填完立刻记到密码管理器。
MYSQL_ROOT_PASSWORD=

# 应用连库用的账号（不是 root）。首次启动时 MySQL 会自动创建这个用户。
DB_USER=classapp
DB_PASSWORD=

# InnoDB 缓冲池大小。4G 内存机器给 256M 是安全值；
# 2G 内存机器改成 128M，同时把 docker-compose.yml 里的 -Xmx512m 降到 -Xmx384m。
MYSQL_BUFFER_POOL=256M

# ---------------------------------------------------------------- 鉴权
# 生成方式（Git Bash 或 Linux 都行）：
#     openssl rand -base64 48
# 必须 ≥32 字节，否则 jjwt 启动就报错。换了这个值，所有已登录用户会被强制重新登录。
JWT_SECRET=

# ---------------------------------------------------------------- 微信
# 微信公众平台 → 开发管理 → 开发设置 → 开发者ID
# AppID 和本地 manifest.json 里的是同一个，Secret 千万不要提交到仓库。
WX_APPID=
WX_SECRET=

# 上面 docker-compose.yml 已固定 WX_MOCK=false，这里不用再写。
# 但要确认 WX_APPID / WX_SECRET 真的填了 ——
# 留空的话登录会抛 2002「微信服务异常」，且日志里看不出是配置问题。
